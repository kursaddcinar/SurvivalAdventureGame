  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Oyuncunun dikkat etmesi geken \"CAN-SU-KALOR\u0130\" de\u011Ferleri mevcuttur.\nCan
    \t=  Zamanla kendisi dolmakta olup e\u011Fer 0'a d\xFC\u015Ferse oyuncu \xF6lmektedir.\nSu\t=
    Su \xF6gesini kullan\u0131nca y\xFCkselmektedir. Zaman ge\xE7tik\xE7e kendisi
    d\xFC\u015Fmektedir. Su de\u011Feri 0'a inerse \"Can\" de\u011Feri azalmaya ba\u015Flar.
    \nKalori\t= Oyuncu hareket ettik\xE7e ve zaman ge\xE7tik\xE7e d\xFC\u015Fmektedir.
    %50 ve %25 de\u011Ferlerinin alt\u0131na d\xFC\u015Ferse oyuncunun h\u0131z\u0131
    azalmaktad\u0131r. Hayvanlardan kazan\u0131lan besinler ile bu de\u011Fer y\xFCkselir."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
